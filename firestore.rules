rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    // El documento es la fuente de permisos: altas, bajas y cambios son inmediatos.
    // activo ausente mantiene compatibilidad con los perfiles existentes.
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function rol() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().get('activo', true) == true ? perfil().get('rol', null) : null;
    }
    function admin() { return autenticado() && rol() == 'admin'; }
    function personal() { return autenticado() && rol() in ['admin', 'cocina', 'salon']; }
    function zona(z) { return personal() && (rol() == 'admin' || rol() == z); }
    function texto(t, maximo) { return t is string && t.size() <= maximo; }
    function numero(n) { return n is number && n >= 0 && n <= 1000000000; }
    function zonaValida(z) { return z in ['cocina', 'salon']; }
    function insumoValido(d) {
      return texto(d.nombre, 200) && d.nombre.size() > 0 && zonaValida(d.zona)
        && d.tipo in ['interno', 'externo'] && texto(d.unidad, 80) && d.unidad.size() > 0
        && numero(d.stockActual) && numero(d.stockMinimo) && d.activo is bool
        && (d.get('stockMinimoFinDeSemana', null) == null || numero(d.stockMinimoFinDeSemana))
        && texto(d.get('categoria', ''), 80) && texto(d.get('ubicacion', ''), 80)
        && (d.get('stockObjetivo', null) == null || numero(d.stockObjetivo))
        && (d.get('stockObjetivoFinDeSemana', null) == null || numero(d.stockObjetivoFinDeSemana))
        && (d.get('consumoDiarioEstimado', null) == null || numero(d.consumoDiarioEstimado));
    }
    match /usuarios/{uid} {
      allow read: if (autenticado() && request.auth.uid == uid) || admin();
      allow create: if admin() || (autenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'rol', 'activo', 'creadoEn'])
        && request.resource.data.rol == null && request.resource.data.activo == true
        && texto(request.resource.data.nombre, 200)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.creadoEn == request.time);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'activo', 'actualizadoEn'])
        && request.resource.data.rol in ['admin', 'cocina', 'salon', null]
        && request.resource.data.get('activo', true) is bool
        && (uid != request.auth.uid || (request.resource.data.rol == 'admin' && request.resource.data.get('activo', true) == true));
      allow delete: if false;
    }
    match /insumos/{id} {
      allow read: if personal();
      allow create: if admin() && insumoValido(request.resource.data);
      allow delete: if admin();
      allow update: if (admin() && insumoValido(request.resource.data)) || (
        zona(resource.data.zona)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockActual', 'actualizadoEn'])
        && numero(request.resource.data.stockActual)
        && request.resource.data.actualizadoEn == request.time);
    }
    match /cierres/{id} {
      allow read: if zona(resource.data.zona);
      allow create: if zona(request.resource.data.zona)
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.fechaHora == request.time
        && request.resource.data.items is list && request.resource.data.items.size() <= 400;
      allow update, delete: if admin();
    }
    match /ajustes/{id} {
      allow read: if zona(resource.data.zona);
      allow create: if zona(request.resource.data.zona)
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.zona == get(/databases/$(database)/documents/insumos/$(request.resource.data.insumoId)).data.zona
        && request.resource.data.tipo in ['descuento', 'reposicion']
        && numero(request.resource.data.cantidad) && request.resource.data.cantidad > 0
        && numero(request.resource.data.stockAnterior) && numero(request.resource.data.stockNuevo)
        && texto(request.resource.data.motivo, 600) && request.resource.data.motivo.size() > 0
        && request.resource.data.fechaHora == request.time;
      allow update, delete: if admin();
    }
    match /reportes/{id} {
      allow read: if zona(resource.data.zona);
      allow create: if zona(request.resource.data.zona)
        && request.resource.data.keys().hasOnly(['insumoId', 'nombre', 'zona', 'tipo', 'nota', 'usuarioId', 'usuarioNombre', 'resuelto', 'fechaHora'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.zona == get(/databases/$(database)/documents/insumos/$(request.resource.data.insumoId)).data.zona
        && texto(request.resource.data.nombre, 200) && texto(request.resource.data.usuarioNombre, 200)
        && request.resource.data.tipo in ['poco', 'agotado', 'problema']
        && texto(request.resource.data.nota, 500)
        && (request.resource.data.tipo != 'problema' || request.resource.data.nota.size() > 0)
        && request.resource.data.resuelto == false && request.resource.data.fechaHora == request.time;
      allow update: if zona(resource.data.zona)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resuelto', 'resueltoPor', 'resueltoEn'])
        && request.resource.data.resuelto == true && request.resource.data.resueltoPor == request.auth.uid
        && request.resource.data.resueltoEn == request.time;
    }
    match /tareasPlantilla/{id} {
      allow read: if zona(resource.data.zona);
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['zona', 'etapa', 'texto', 'activo'])
        && zonaValida(request.resource.data.zona) && request.resource.data.etapa in ['apertura', 'cierre']
        && texto(request.resource.data.texto, 200) && request.resource.data.texto.size() > 0 && request.resource.data.activo is bool;
    }
    match /tareasTurno/{id} {
      allow read: if zona(resource.data.zona);
      allow create, update: if zona(request.resource.data.zona)
        && request.resource.data.keys().hasOnly(['zona', 'fecha', 'turno', 'tareaId', 'texto', 'completada', 'usuarioId', 'usuarioNombre', 'actualizadoEn'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.turno in ['mañana', 'tarde', 'noche']
        && texto(request.resource.data.tareaId, 200) && texto(request.resource.data.texto, 200)
        && texto(request.resource.data.usuarioNombre, 200) && request.resource.data.completada is bool
        && id == request.resource.data.fecha + '_' + request.resource.data.turno + '_' + request.resource.data.zona + '_' + request.resource.data.tareaId
        && request.resource.data.actualizadoEn == request.time;
    }
  }
}
